 "beats": [
  {
   "n": 1,
   "id": "hook_never_see_it",
   "beat": "HOOK",
   "register": "void",
   "line": "Look at this planet, and understand that you are never going to see it, ever.",
   "start": 0.0,
   "end": 3.52,
   "dur": 3.52,
   "words": 15,
   "wav": "_beats/001.wav"
  },
  {
   "n": 2,
   "id": "albedo_one_percent",
   "beat": "DATA",
   "register": "cream",
   "line": "It reflects less than one percent of all the light its star sends down at it.",
   "start": 4.12,
   "end": 7.65,
   "dur": 3.53,
   "words": 16,
   "wav": "_beats/002.wav"
  },
  {
   "n": 3,
   "id": "darker_than_coal",
   "beat": "COMPARISON",
   "register": "void",
   "line": "Darker than coal. Darker than asphalt. The instruments measured it twice, and both times said yes.",
   "start": 8.25,
   "end": 13.33,
   "dur": 5.08,
   "words": 16,
   "wav": "_beats/003.wav"
  },
  {
   "n": 4,
   "id": "tidally_locked_reveal",
   "beat": "REVEAL",
   "register": "cream",
   "line": "Now the part that makes the darkness genuinely obscene: the planet is tidally locked.",
   "start": 13.93,
   "end": 17.94,
   "dur": 4.01,
   "words": 14,
   "wav": "_beats/004.wav"
  },
  {
   "n": 5,
   "id": "two_faces_forever",
   "beat": "DIAGRAM",
   "register": "void",
   "line": "One hemisphere faces the star forever, and the other hemisphere never sees it at all.",
   "start": 18.54,
   "end": 22.45,
   "dur": 3.91,
   "words": 15,
   "wav": "_beats/005.wav"
  },
  {
   "n": 6,
   "id": "never_warms_never_cools",
   "beat": "REACTION",
   "register": "cream",
   "line": "So the night side never warms at all, and the day side never gets the chance to cool.",
   "start": 23.05,
   "end": 26.74,
   "dur": 3.69,
   "words": 18,
   "wav": "_beats/006.wav"
  },
  {
   "n": 7,
   "id": "day_side_furnace",
   "beat": "DATA",
   "register": "void",
   "line": "That day side is a furnace, thousands of degrees of gas, and none of it is visible.",
   "start": 27.34,
   "end": 31.47,
   "dur": 4.13,
   "words": 17,
   "wav": "_beats/007.wav"
  },
  {
   "n": 8,
   "id": "dull_red_glow",
   "beat": "PORTRAIT",
   "register": "cream",
   "line": "It does glow, faintly, a dull red at about two thousand kelvin, like coals in a hearth.",
   "start": 32.07,
   "end": 36.66,
   "dur": 4.59,
   "words": 17,
   "wav": "_beats/008.wav"
  },
  {
   "n": 9,
   "id": "hot_but_too_dark",
   "beat": "REACTION",
   "register": "void",
   "line": "Hot enough to strip skin off you. Too dark to reflect much of the light that made it.",
   "start": 37.26,
   "end": 40.66,
   "dur": 3.4,
   "words": 18,
   "wav": "_beats/009.wav"
  },
  {
   "n": 10,
   "id": "watch_the_star",
   "beat": "PIVOT",
   "register": "cream",
   "line": "Now watch the star it orbits, because the star is what finishes this whole story.",
   "start": 41.26,
   "end": 45.68,
   "dur": 4.42,
   "words": 15,
   "wav": "_beats/010.wav"
  },
  {
   "n": 11,
   "id": "star_running_out_of_fuel",
   "beat": "DATA",
   "register": "void",
   "line": "The star it orbits is small, and red, and running low on the fuel that keeps it alive.",
   "start": 46.28,
   "end": 50.38,
   "dur": 4.1,
   "words": 18,
   "wav": "_beats/011.wav"
  },
  {
   "n": 12,
   "id": "swelling_and_closer",
   "beat": "REACTION",
   "register": "cream",
   "line": "So it is swelling, and it is coming closer, and it is pulling the air off the planet.",
   "start": 50.98,
   "end": 55.21,
   "dur": 4.23,
   "words": 18,
   "wav": "_beats/012.wav"
  },
  {
   "n": 13,
   "id": "atmosphere_as_tail",
   "beat": "DIAGRAM",
   "register": "void",
   "line": "The whole atmosphere comes off the planet in sheets, trailing away as a long glowing tail.",
   "start": 55.81,
   "end": 59.95,
   "dur": 4.14,
   "words": 16,
   "wav": "_beats/013.wav"
  },
  {
   "n": 14,
   "id": "unmade_by_its_own_sun",
   "beat": "FATE",
   "register": "cream",
   "line": "And the darkest planet anyone has ever found is being unmade by its own sun.",
   "start": 60.55,
   "end": 64.72,
   "dur": 4.17,
   "words": 15,
   "wav": "_beats/014.wav"
