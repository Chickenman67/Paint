 "beats": [
  {
   "n": 1,
   "id": "hook_brightest_star",
   "beat": "HOOK",
   "register": "void",
   "line": "Fomalhaut is the brightest star in the autumn sky, easy to spot and impossible to forget.",
   "start": 0.0,
   "end": 4.54,
   "dur": 4.54,
   "words": 16,
   "wav": "_beats/001.wav"
  },
  {
   "n": 2,
   "id": "the_ring",
   "beat": "SETUP",
   "register": "cream",
   "line": "Around it lies a ring. A wide, thin belt of dust and ice, far past where any planet should be.",
   "start": 5.14,
   "end": 9.95,
   "dur": 4.81,
   "words": 20,
   "wav": "_beats/002.wav"
  },
  {
   "n": 3,
   "id": "light_in_the_ring",
   "beat": "REVEAL",
   "register": "void",
   "line": "In 2008, something inside that ring caught the light and held it.",
   "start": 10.55,
   "end": 13.78,
   "dur": 3.23,
   "words": 12,
   "wav": "_beats/003.wav"
  },
  {
   "n": 4,
   "id": "first_visible_planet",
   "beat": "REVEAL2",
   "register": "cream",
   "line": "The first planet ever imaged in visible light around a star that was not our Sun.",
   "start": 14.38,
   "end": 17.87,
   "dur": 3.49,
   "words": 16,
   "wav": "_beats/004.wav"
  },
  {
   "n": 5,
   "id": "the_headline",
   "beat": "TURN",
   "register": "void",
   "line": "That was the headline. The whole field sat back, because that was supposed to be the end of the argument.",
   "start": 18.47,
   "end": 23.04,
   "dur": 4.57,
   "words": 20,
   "wav": "_beats/005.wav"
  },
  {
   "n": 6,
   "id": "not_the_end",
   "beat": "DOUBT",
   "register": "cream",
   "line": "It was not the end. The signal is so faint that some astronomers still call it a dust cloud.",
   "start": 23.64,
   "end": 28.37,
   "dur": 4.73,
   "words": 19,
   "wav": "_beats/006.wav"
  },
  {
   "n": 7,
   "id": "maybe_dust",
   "beat": "HYPOTHESIS_A",
   "register": "void",
   "line": "Just dust, kicked up by something invisible passing through the ring on its way out.",
   "start": 28.97,
   "end": 32.92,
   "dur": 3.95,
   "words": 15,
   "wav": "_beats/007.wav"
  },
  {
   "n": 8,
   "id": "maybe_world",
   "beat": "HYPOTHESIS_B",
   "register": "cream",
   "line": "Or a real world, shepherding the ring, holding that whole belt in its gravity.",
   "start": 33.52,
   "end": 37.48,
   "dur": 3.96,
   "words": 14,
   "wav": "_beats/008.wav"
  },
  {
   "n": 9,
   "id": "two_things_same_pixels",
   "beat": "PARADOX",
   "register": "void",
   "line": "Same light. Same picture. Two entirely different things, and no telescope alive can tell them apart.",
   "start": 38.08,
   "end": 43.76,
   "dur": 5.68,
   "words": 16,
   "wav": "_beats/009.wav"
  },
  {
   "n": 10,
   "id": "the_orbit",
   "beat": "ORBIT",
   "register": "cream",
   "line": "Then there is the orbit. It swings in close to the star, then throws itself far out into the cold.",
   "start": 44.36,
   "end": 49.64,
   "dur": 5.28,
   "words": 20,
   "wav": "_beats/010.wav"
  },
  {
   "n": 11,
   "id": "orbit_not_tidy",
   "beat": "ORBIT_BAD",
   "register": "void",
   "line": "An ellipse that wild does not stay tidy for long.",
   "start": 50.24,
   "end": 52.38,
   "dur": 2.14,
   "words": 10,
   "wav": "_beats/011.wav"
  },
  {
   "n": 12,
   "id": "one_bad_pass",
   "beat": "WARNING",
   "register": "cream",
   "line": "One bad pass, one nudge from that star, and it never comes back around.",
   "start": 52.98,
   "end": 56.77,
   "dur": 3.79,
   "words": 14,
   "wav": "_beats/012.wav"
  },
  {
   "n": 13,
   "id": "the_long_fall",
   "beat": "FATE",
   "register": "void",
   "line": "So the likeliest ending is a long, silent fall out of the system, with nothing left to catch it.",
   "start": 57.37,
   "end": 62.2,
   "dur": 4.83,
   "words": 19,
   "wav": "_beats/013.wav"
  },
  {
   "n": 14,
   "id": "cloud_world_or_gone",
   "beat": "CLOSE",
   "register": "cream",
   "line": "The first planet we ever saw in visible light. Maybe a cloud. Maybe a world. Maybe already gone.",
   "start": 62.8,
   "end": 68.02,
   "dur": 5.22,
   "words": 18,
   "wav": "_beats/014.wav"
  }
