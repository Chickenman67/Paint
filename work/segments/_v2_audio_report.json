  "boundary_basis": "exact -- per-beat renders atempo-stretched then concatenated",
  "beats": [
   {
    "n": 1,
    "id": "hook_never_see_it",
    "beat": "HOOK",
    "line": "Look at this planet. You will never see it. Not once, not ever.",
    "start": 0.0,
    "end": 4.6,
    "dur": 4.6,
    "words": 13,
    "wav": "_v2beats/001.wav"
   },
   {
    "n": 2,
    "id": "albedo_one_percent",
    "beat": "ALBEDO",
    "line": "It bounces back less than one percent of the light its star sends down.",
    "start": 4.68,
    "end": 8.955,
    "dur": 4.275,
    "words": 14,
    "wav": "_v2beats/002.wav"
   },
   {
    "n": 3,
    "id": "darker_than_coal",
    "beat": "COMPARISON",
    "line": "That is darker than coal. Darker than asphalt. The instruments checked it twice. Both times they agreed.",
    "start": 9.035,
    "end": 15.435,
    "dur": 6.4,
    "words": 17,
    "wav": "_v2beats/003.wav"
   },
   {
    "n": 4,
    "id": "tidally_locked_reveal",
    "beat": "REVEAL",
    "line": "Here is the part that makes this darkness obscene. The planet is tidally locked. One side never moves.",
    "start": 15.515,
    "end": 22.932,
    "dur": 7.416,
    "words": 18,
    "wav": "_v2beats/004.wav"
   },
   {
    "n": 5,
    "id": "two_faces_forever",
    "beat": "TWO_SIDES",
    "line": "One half faces the star forever. The other half never sees it at all.",
    "start": 23.012,
    "end": 27.226,
    "dur": 4.214,
    "words": 14,
    "wav": "_v2beats/005.wav"
   },
   {
    "n": 6,
    "id": "never_warms_never_cools",
    "beat": "LOCKED",
    "line": "So the night side never warms. The day side never cools.",
    "start": 27.306,
    "end": 30.839,
    "dur": 3.533,
    "words": 11,
    "wav": "_v2beats/006.wav"
   },
   {
    "n": 7,
    "id": "day_side_furnace",
    "beat": "FURNACE",
    "line": "That day side is a furnace. Thousands of degrees of gas.",
    "start": 30.919,
    "end": 34.449,
    "dur": 3.529,
    "words": 11,
    "wav": "_v2beats/007.wav"
   },
   {
    "n": 8,
    "id": "dull_red_glow",
    "beat": "GLOW",
    "line": "It does glow, faintly. A dull red. About two thousand kelvin. Like coals left in a hearth.",
    "start": 34.529,
    "end": 41.364,
    "dur": 6.835,
    "words": 17,
    "wav": "_v2beats/008.wav"
   },
   {
    "n": 9,
    "id": "hot_but_too_dark",
    "beat": "PARADOX",
    "line": "Hot enough to strip the skin off your hand. Too dark to reflect the light that made it hot.",
    "start": 41.444,
    "end": 46.538,
    "dur": 5.094,
    "words": 19,
    "wav": "_v2beats/009.wav"
   },
   {
    "n": 10,
    "id": "watch_the_star",
    "beat": "PIVOT",
    "line": "Now watch the star it orbits. The star is what finishes this story.",
    "start": 46.618,
    "end": 51.546,
    "dur": 4.928,
    "words": 13,
    "wav": "_v2beats/010.wav"
   },
   {
    "n": 11,
    "id": "star_running_out_of_fuel",
    "beat": "THE_STAR",
    "line": "The star is small and red. It is running low on the fuel that keeps it alive.",
    "start": 51.626,
    "end": 56.862,
    "dur": 5.236,
    "words": 17,
    "wav": "_v2beats/011.wav"
   },
   {
    "n": 12,
    "id": "swelling_and_closer",
    "beat": "SWELLING",
    "line": "So it is swelling. It is creeping closer. It is pulling the air off the planet.",
    "start": 56.942,
    "end": 62.948,
    "dur": 6.006,
    "words": 16,
    "wav": "_v2beats/012.wav"
   },
   {
    "n": 13,
    "id": "atmosphere_as_tail",
    "beat": "TAIL",
    "line": "The whole atmosphere comes off in sheets, trailing away as a long glowing tail.",
    "start": 63.028,
    "end": 68.228,
    "dur": 5.2,
    "words": 14,
    "wav": "_v2beats/013.wav"
   },
   {
    "n": 14,
    "id": "unmade_by_its_own_sun",
    "beat": "FINALE",
    "line": "And the darkest planet anyone has ever found is being unmade by its own sun.",
    "start": 68.308,
    "end": 73.5,
    "dur": 5.192,
    "words": 15,
    "wav": "_v2beats/014.wav"
   }
  ],
  "render_s": 2.6
 },
 {
  "segment": "wasp17b",
  "wav_path": "v2_audio.wav",
