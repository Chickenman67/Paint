   ],
   "raw_wpm": 241.5,
   "speech_wpm": 172.5,
   "squeeze_saved_s": 3.72
  },
  "boundary_basis": "exact -- per-beat renders atempo-stretched then concatenated",
  "beats": [
   {
    "n": 1,
    "id": "hook_a_sun_you_know",
    "beat": "HOOK",
    "line": "Every planet you have met so far had a sun.\nA star to rise into, and set behind.",
    "start": 0.0,
    "end": 6.346,
    "dur": 6.346,
    "words": 18,
    "wav": "_v2beats/001.wav"
   },
   {
    "n": 2,
    "id": "ejection_neighbor_comes_too_close",
    "beat": "SETUP",
    "line": "This one lost all of that.\nSomething kicked it out of its system.\nA neighbor, moving too close, too fast.",
    "start": 6.426,
    "end": 13.121,
    "dur": 6.695,
    "words": 20,
    "wav": "_v2beats/002.wav"
   },
   {
    "n": 3,
    "id": "thrown_into_the_between",
    "beat": "ESCAPE",
    "line": "Thrown loose into the dark between the stars.\nIt has been falling ever since.",
    "start": 13.201,
    "end": 17.976,
    "dur": 4.774,
    "words": 14,
    "wav": "_v2beats/003.wav"
   },
   {
    "n": 4,
    "id": "no_star_to_orbit",
    "beat": "SETUP",
    "line": "It drifts through interstellar space, and nothing slows it.\nNo star to orbit.\nNo sunrise. No sunset. Nothing to rise or set.",
    "start": 18.056,
    "end": 27.729,
    "dur": 9.674,
    "words": 22,
    "wav": "_v2beats/004.wav"
   },
   {
    "n": 5,
    "id": "no_light_of_its_own",
    "beat": "REVEAL",
    "line": "No light of its own.\nIt is only ever lit by what other stars leak.",
    "start": 27.809,
    "end": 31.879,
    "dur": 4.07,
    "words": 15,
    "wav": "_v2beats/005.wav"
   },
   {
    "n": 6,
    "id": "barely_enough_to_see",
    "beat": "PAYOFF",
    "line": "A thin drizzle of scattered light, from impossibly far away.\nBarely enough to see by.\nBarely enough for anyone to be seen.",
    "start": 31.959,
    "end": 41.055,
    "dur": 9.096,
    "words": 22,
    "wav": "_v2beats/006.wav"
   },
   {
    "n": 7,
    "id": "what_rogue_means",
    "beat": "CONTEXT",
    "line": "This is what it means to be a rogue planet.\nNo parent star. No system. No address at all.",
    "start": 41.135,
    "end": 47.661,
    "dur": 6.526,
    "words": 19,
    "wav": "_v2beats/007.wav"
   },
   {
    "n": 8,
    "id": "coldest_and_darkest",
    "beat": "ESCALATE",
    "line": "Among the coldest objects we have ever measured.\nAmong the very darkest we know of.\nNothing about this world is friendly.",
    "start": 47.741,
    "end": 55.488,
    "dur": 7.748,
    "words": 21,
    "wav": "_v2beats/008.wav"
   },
   {
    "n": 9,
    "id": "less_than_darkness",
    "beat": "PAYOFF",
    "line": "Imagine standing there, and seeing nothing at all.\nNot darkness. Less than darkness.\nYou would never find the edge of the ground.",
    "start": 55.568,
    "end": 62.833,
    "dur": 7.265,
    "words": 22,
    "wav": "_v2beats/009.wav"
   },
   {
    "n": 10,
    "id": "the_dust_ring",
    "beat": "REVEAL",
    "line": "A small ring of dust still orbits it.\nLeftovers from a system that no longer exists.",
    "start": 62.913,
    "end": 68.254,
    "dur": 5.341,
    "words": 16,
    "wav": "_v2beats/010.wav"
   },
   {
    "n": 11,
    "id": "a_suns_worth_of_wreckage",
    "beat": "ESCALATE",
    "line": "A whole sun's worth of wreckage, in one thin circle.\nIt circles nothing at all.\nThe dust keeps its shape out of pure habit.",
    "start": 68.334,
    "end": 76.245,
    "dur": 7.91,
    "words": 24,
    "wav": "_v2beats/011.wav"
   },
   {
    "n": 12,
    "id": "it_passes_you",
    "beat": "PAYOFF",
    "line": "You are watching it pass, and it will never know you.\nAnd you will never get there.",
    "start": 76.325,
    "end": 81.245,
    "dur": 4.92,
    "words": 17,
    "wav": "_v2beats/012.wav"
   },
   {
    "n": 13,
    "id": "the_loneliest_thing_found",
    "beat": "FINALE",
    "line": "It is the loneliest thing we have ever found.",
    "start": 81.325,
    "end": 84.095,
    "dur": 2.77,
    "words": 9,
    "wav": "_v2beats/013.wav"
   }
  ],
  "render_s": 0.8
 }
]