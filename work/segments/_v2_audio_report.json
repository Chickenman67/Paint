    0.7676,
    0.7676,
    0.7676,
    0.7676
   ],
   "raw_wpm": 224.3,
   "speech_wpm": 172.7,
   "squeeze_saved_s": 3.49
  },
  "boundary_basis": "exact -- per-beat renders atempo-stretched then concatenated",
  "beats": [
   {
    "n": 1,
    "id": "hook_inverted",
    "beat": "HOOK",
    "line": "Some planets swallow the light that reaches them.\nThis one hands it back.",
    "start": 0.0,
    "end": 4.058,
    "dur": 4.058,
    "words": 13,
    "wav": "_v2beats/001.wav"
   },
   {
    "n": 2,
    "id": "name_card",
    "beat": "NAME",
    "line": "LTT 9779 b is a super-Earth with a permanent gleam.\nIts star is quiet. Dim. Easy to overlook.",
    "start": 4.138,
    "end": 11.962,
    "dur": 7.824,
    "words": 18,
    "wav": "_v2beats/002.wav"
   },
   {
    "n": 3,
    "id": "planet_is_loud",
    "beat": "ESCALATE",
    "line": "The planet is not easy to overlook.\nIt sits close in, and it never gets the chance to cool down.",
    "start": 12.042,
    "end": 18.182,
    "dur": 6.14,
    "words": 20,
    "wav": "_v2beats/003.wav"
   },
   {
    "n": 4,
    "id": "metal_sky",
    "beat": "REVEAL",
    "line": "High above the surface, the sky is made of metal.\nClouds of metal, miles up, doing nothing useful.",
    "start": 18.262,
    "end": 24.835,
    "dur": 6.573,
    "words": 18,
    "wav": "_v2beats/004.wav"
   },
   {
    "n": 5,
    "id": "irradiated_dayside",
    "beat": "ESCALATE",
    "line": "The dayside is irradiated. Continuously. Without pause.\nYet the surface never cooks.",
    "start": 24.915,
    "end": 31.131,
    "dur": 6.216,
    "words": 12,
    "wav": "_v2beats/005.wav"
   },
   {
    "n": 6,
    "id": "nothing_absorbed",
    "beat": "MECHANISM",
    "line": "Almost none of that light is absorbed.\nNearly all of it is reflected straight back into space.",
    "start": 31.211,
    "end": 36.43,
    "dur": 5.219,
    "words": 17,
    "wav": "_v2beats/006.wav"
   },
   {
    "n": 7,
    "id": "coin_in_the_dark",
    "beat": "PUNCHLINE",
    "line": "From a distance, the planet glows like a coin in the dark.\nNot a coal. A mirror.",
    "start": 36.51,
    "end": 41.875,
    "dur": 5.365,
    "words": 17,
    "wav": "_v2beats/007.wav"
   },
   {
    "n": 8,
    "id": "the_bad_number",
    "beat": "BEAT",
    "line": "Astronomers measured the brightness and did not believe it.\nA number that high usually means a mistake.",
    "start": 41.955,
    "end": 47.772,
    "dur": 5.817,
    "words": 17,
    "wav": "_v2beats/008.wav"
   },
   {
    "n": 9,
    "id": "checked_twice",
    "beat": "BEAT",
    "line": "They checked. It is one of the most reflective worlds known.\nThe night side stays dark. The day side burns.",
    "start": 47.852,
    "end": 54.049,
    "dur": 6.197,
    "words": 20,
    "wav": "_v2beats/009.wav"
   },
   {
    "n": 10,
    "id": "should_be_an_oven",
    "beat": "BEAT",
    "line": "That is the unsettling part.\nThe hottest worlds should look like ovens.",
    "start": 54.129,
    "end": 58.409,
    "dur": 4.28,
    "words": 12,
    "wav": "_v2beats/010.wav"
   },
   {
    "n": 11,
    "id": "smile_at_mild_star",
    "beat": "REVEAL",
    "line": "This one looks like it is smiling.\nIt orbits a star so mild it barely deserves the name.",
    "start": 58.489,
    "end": 64.555,
    "dur": 6.066,
    "words": 18,
    "wav": "_v2beats/011.wav"
   },
   {
    "n": 12,
    "id": "brilliant_and_bare",
    "beat": "BEAT",
    "line": "And still the planet comes back brilliant.\nNo surface you could stand on. No sky you could breathe.",
    "start": 64.635,
    "end": 70.8,
    "dur": 6.165,
    "words": 18,
    "wav": "_v2beats/012.wav"
   },
   {
    "n": 13,
    "id": "no_survival",
    "beat": "DREAD",
    "line": "You would not survive a single breath up there.\nNothing down there generates its own shine.",
    "start": 70.88,
    "end": 75.792,
    "dur": 4.912,
    "words": 16,
    "wav": "_v2beats/013.wav"
   },
   {
    "n": 14,
    "id": "borrowed_light",
    "beat": "CLOSER",
    "line": "It is the brightest warning light in a quiet system.\nThe gleam is borrowed. And it never stops.",
    "start": 75.872,
    "end": 82.33,
    "dur": 6.458,
    "words": 18,
    "wav": "_v2beats/014.wav"
   }
  ],
  "render_s": 0.8
 },
 {
  "segment": "fomalhautb",
  "wav_path": "v2_audio.wav",
  "duration_s": 79.48,
  "sample_rate": 24000,
  "word_count": 226,
  "speech_s": 78.439,
  "gap_s": 0.08,
  "wpm": 170.6,
  "pause_frac": 0.013,
  "on_target": true,
  "params": {
   "exaggeration": 0.5,
   "cfg_weight": 0.5,
   "temperature": 0.8,
   "target_wpm": 170.0,
   "nominal_gap_s": 0.08,
   "pause_squeeze_above_s": 0.16,
   "pause_squeeze_to_s": 0.07,
   "bright_shelf_hz": 3500,
   "bright_shelf_db": 3.0,
   "tempo_factors": [
    0.7331,
    0.7331,
    0.7331,
    0.7331,
    0.7331,
    0.7331,
    0.7331,
    0.7331,
    0.7331,
    0.7331,
    0.7331,
    0.7331,
    0.7331,
    0.7331
   ],
   "raw_wpm": 235.0,
   "speech_wpm": 172.9,
   "squeeze_saved_s": 3.17
  },
  "boundary_basis": "exact -- per-beat renders atempo-stretched then concatenated",
  "beats": [
   {
    "n": 1,
    "id": "hook_brightest_star",
    "beat": "HOOK",
    "line": "Fomalhaut is the brightest star in the autumn sky. Easy to spot. Hard to forget.",
    "start": 0.0,
    "end": 5.461,
    "dur": 5.461,
    "words": 15,
    "wav": "_v2beats/001.wav"
   },
   {
    "n": 2,
    "id": "the_ring",
    "beat": "RING",
    "line": "Around it lies a ring. A wide, thin belt of dust and ice. It sits far past where any planet should be.",
    "start": 5.541,
    "end": 13.996,
    "dur": 8.455,
    "words": 22,
    "wav": "_v2beats/002.wav"
   },
   {
    "n": 3,
    "id": "light_in_the_ring",
    "beat": "THE_LIGHT",
    "line": "In 2008, something inside that ring caught the light and held it.",
    "start": 14.076,
    "end": 18.825,
    "dur": 4.749,
    "words": 12,
    "wav": "_v2beats/003.wav"
   },
   {
    "n": 4,
    "id": "first_visible_planet",
    "beat": "FIRST_SIGHT",
    "line": "The first planet ever imaged in visible light around a star that was not our Sun.",
    "start": 18.905,
    "end": 24.024,
    "dur": 5.119,
    "words": 16,
    "wav": "_v2beats/004.wav"
   },
   {
    "n": 5,
    "id": "the_headline",
    "beat": "HEADLINE",
    "line": "That was the headline. The whole field sat back. That was supposed to be the end of the argument.",
    "start": 24.104,
    "end": 29.372,
    "dur": 5.268,
    "words": 19,
    "wav": "_v2beats/005.wav"
   },
   {
    "n": 6,
    "id": "not_the_end",
    "beat": "DOUBT",
    "line": "It was not the end. The signal is so faint that some astronomers still call it a dust cloud.",
    "start": 29.453,
    "end": 34.951,
    "dur": 5.499,
    "words": 19,
    "wav": "_v2beats/006.wav"
   },
   {
    "n": 7,
    "id": "maybe_dust",
    "beat": "DUST",
    "line": "Just dust, kicked up by something invisible passing through the ring on its way out.",
    "start": 35.031,
    "end": 40.072,
    "dur": 5.04,
    "words": 15,
    "wav": "_v2beats/007.wav"
   },
   {
    "n": 8,
    "id": "maybe_world",
    "beat": "WORLD",
    "line": "Or a real world, holding that whole belt in its gravity.",
    "start": 40.152,
    "end": 43.935,
    "dur": 3.784,
    "words": 11,
    "wav": "_v2beats/008.wav"
   },
   {
    "n": 9,
    "id": "two_things_same_pixels",
    "beat": "AMBIGUOUS",
    "line": "Same light. Same picture. Two very different things. No telescope alive can tell them apart.",
    "start": 44.015,
    "end": 50.254,
    "dur": 6.239,
    "words": 15,
    "wav": "_v2beats/009.wav"
   },
   {
    "n": 10,
    "id": "the_orbit",
    "beat": "ORBIT",
    "line": "Then there is the orbit. It swings in close to the star, then throws itself far out into the cold.",
    "start": 50.334,
    "end": 57.446,
    "dur": 7.111,
    "words": 20,
    "wav": "_v2beats/010.wav"
   },
   {
    "n": 11,
    "id": "orbit_not_tidy",
    "beat": "UNTIDY",
    "line": "An orbit that wild does not stay tidy for long.",
    "start": 57.526,
    "end": 60.664,
    "dur": 3.138,
    "words": 10,
    "wav": "_v2beats/011.wav"
   },
   {
    "n": 12,
    "id": "one_bad_pass",
    "beat": "BAD_PASS",
    "line": "One bad pass. One nudge from that star. And it never comes back around.",
    "start": 60.744,
    "end": 66.384,
    "dur": 5.641,
    "words": 14,
    "wav": "_v2beats/012.wav"
   },
   {
    "n": 13,
    "id": "the_long_fall",
    "beat": "THE_FALL",
    "line": "So the likeliest ending is a long, silent fall out of the system. Nothing left out there to catch it.",
    "start": 66.464,
    "end": 73.713,
    "dur": 7.248,
    "words": 20,
    "wav": "_v2beats/013.wav"
   },
   {
    "n": 14,
    "id": "cloud_world_or_gone",
    "beat": "FINALE",
    "line": "The first planet we ever saw in visible light. Maybe a cloud. Maybe a world. Maybe already gone.",
    "start": 73.793,
    "end": 79.48,
    "dur": 5.687,
    "words": 18,
    "wav": "_v2beats/014.wav"
   }
  ],
  "render_s": 0.8
 },
 {
  "segment": "psrb1257",
  "wav_path": "v2_audio.wav",
