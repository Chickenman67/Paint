   "cfg_weight": 0.5,
   "temperature": 0.8,
   "target_wpm": 170.0,
   "nominal_gap_s": 0.08,
   "pause_squeeze_above_s": 0.16,
   "pause_squeeze_to_s": 0.07,
   "bright_shelf_hz": 3500,
   "bright_shelf_db": 3.0,
   "tempo_factors": [
