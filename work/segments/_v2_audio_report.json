    0.7185,
    0.7185
   ],
   "raw_wpm": 240.5,
   "speech_wpm": 173.6,
   "squeeze_saved_s": 1.69
  },
  "boundary_basis": "exact -- per-beat renders atempo-stretched then concatenated",
  "beats": [
   {
    "n": 1,
    "id": "hook_dead_star",
    "beat": "HOOK",
    "line": "This star died a long time ago. It is still out there, spinning.",
    "start": 0.0,
    "end": 4.637,
    "dur": 4.637,
    "words": 13,
    "wav": "_v2beats/001.wav"
   },
   {
    "n": 2,
    "id": "spinning_fast",
    "beat": "HOOK",
    "line": "It spins so fast that it is turning itself into a smear of light.",
    "start": 4.717,
    "end": 9.415,
    "dur": 4.698,
    "words": 14,
    "wav": "_v2beats/002.wav"
   },
   {
    "n": 3,
    "id": "beam_sweeps",
    "beat": "SETUP",
    "line": "A beam of radiation sweeps out of it. It does this twice, every second.",
    "start": 9.495,
    "end": 14.292,
    "dur": 4.796,
    "words": 14,
    "wav": "_v2beats/003.wav"
   },
   {
    "n": 4,
    "id": "planets_around",
    "beat": "SETUP",
    "line": "And there are planets. Real planets. Orbiting it right now.",
    "start": 14.372,
    "end": 19.016,
    "dur": 4.644,
    "words": 10,
    "wav": "_v2beats/004.wav"
   },
   {
    "n": 5,
    "id": "named_undead",
    "beat": "SETUP",
    "line": "They are named after the undead. The first one is called Draugr.",
    "start": 19.096,
    "end": 23.695,
    "dur": 4.599,
    "words": 12,
    "wav": "_v2beats/005.wav"
   },
   {
    "n": 6,
    "id": "draugr_corpse",
    "beat": "ESCALATE",
    "line": "A draugr is a corpse that walks. That is the name they gave it.",
    "start": 23.775,
    "end": 28.105,
    "dur": 4.33,
    "words": 14,
    "wav": "_v2beats/006.wav"
   },
   {
    "n": 7,
    "id": "named_all_of_them",
    "beat": "ESCALATE",
    "line": "The next two are named Poltergeist and Lich. It does not get kinder.",
    "start": 28.185,
    "end": 32.865,
    "dur": 4.68,
    "words": 13,
    "wav": "_v2beats/007.wav"
   },
   {
    "n": 8,
    "id": "first_around_dead",
    "beat": "ESCALATE",
    "line": "These are the first planets ever found orbiting a dead star.",
    "start": 32.945,
    "end": 37.103,
    "dur": 4.158,
    "words": 11,
    "wav": "_v2beats/008.wav"
   },
   {
    "n": 9,
    "id": "should_not_exist",
    "beat": "ESCALATE",
    "line": "They should not exist. A dead star has nothing left to hold on to.",
    "start": 37.183,
    "end": 41.496,
    "dur": 4.312,
    "words": 14,
    "wav": "_v2beats/009.wav"
   },
   {
    "n": 10,
    "id": "carbon_dense",
    "beat": "DISTURB",
    "line": "The planets are carbon. They are the densest rock in the whole galaxy.",
    "start": 41.576,
    "end": 46.614,
    "dur": 5.038,
    "words": 13,
    "wav": "_v2beats/010.wav"
   },
   {
    "n": 11,
    "id": "fist_of_coal",
    "beat": "DISTURB",
    "line": "A fist of coal you could hold in one hand, if you could ever stand on it.",
    "start": 46.694,
    "end": 51.067,
    "dur": 4.373,
    "words": 17,
    "wav": "_v2beats/011.wav"
   },
   {
    "n": 12,
    "id": "orbits_tight",
    "beat": "DISTURB",
    "line": "They whip around a dead star in a couple of hours each.",
    "start": 51.147,
    "end": 54.802,
    "dur": 3.654,
    "words": 12,
    "wav": "_v2beats/012.wav"
   },
   {
    "n": 13,
    "id": "solar_system_size",
    "beat": "DISTURB",
    "line": "And the entire system is about the size of our own solar system.",
    "start": 54.882,
    "end": 59.289,
    "dur": 4.407,
    "words": 13,
    "wav": "_v2beats/013.wav"
   },
   {
    "n": 14,
    "id": "graveyard",
    "beat": "OUTRO",
    "line": "A graveyard the size of ours, turning over and over in the dark.",
    "start": 59.369,
    "end": 64.159,
    "dur": 4.79,
    "words": 13,
    "wav": "_v2beats/014.wav"
   },
   {
    "n": 15,
    "id": "outro_beam",
    "beat": "OUTRO",
    "line": "The dead star beams at you. The planets do not care. They keep going.",
    "start": 64.239,
    "end": 69.213,
    "dur": 4.974,
    "words": 14,
    "wav": "_v2beats/015.wav"
   }
  ],
  "render_s": 0.8
 },
 {
  "segment": "kelt9b",
  "wav_path": "v2_audio.wav",
  "duration_s": 87.327,
  "sample_rate": 24000,
  "word_count": 248,
  "speech_s": 86.447,
  "gap_s": 0.08,
  "wpm": 170.4,
  "pause_frac": 0.01,
  "on_target": true,
  "params": {
   "exaggeration": 0.5,
   "cfg_weight": 0.5,
   "temperature": 0.8,
   "target_wpm": 170.0,
   "nominal_gap_s": 0.08,
   "pause_squeeze_above_s": 0.16,
   "pause_squeeze_to_s": 0.07,
   "bright_shelf_hz": 3500,
   "bright_shelf_db": 3.0,
   "tempo_factors": [
    0.7562,
    0.7562,
    0.7562,
    0.7562,
    0.7562,
    0.7562,
    0.7562,
    0.7562,
    0.7562,
    0.7562,
    0.7562,
    0.7562
   ],
   "raw_wpm": 227.1,
   "speech_wpm": 172.1,
   "squeeze_saved_s": 3.19
  },
  "boundary_basis": "exact -- per-beat renders atempo-stretched then concatenated",
  "beats": [
   {
    "n": 1,
    "id": "hook",
    "beat": "HOOK",
    "line": "This is the hottest planet ever found.\nIt is hotter than most stars in the galaxy.\nNot a little hotter. Considerably hotter.",
    "start": 0.0,
    "end": 7.875,
    "dur": 7.875,
    "words": 22,
    "wav": "_v2beats/001.wav"
   },
   {
    "n": 2,
    "id": "the_record",
    "beat": "THE RECORD",
    "line": "Even the word planet feels like rounding it up.\nIts name is KELT plus nine b.",
    "start": 7.955,
    "end": 13.778,
    "dur": 5.822,
    "words": 16,
    "wav": "_v2beats/002.wav"
   },
   {
    "n": 3,
    "id": "the_orbit",
    "beat": "THE ORBIT",
    "line": "It circles closer than any planet should.\nOne year there lasts about a day and a half.",
    "start": 13.858,
    "end": 19.121,
    "dur": 5.263,
    "words": 17,
    "wav": "_v2beats/003.wav"
   },
   {
    "n": 4,
    "id": "no_escape",
    "beat": "NO ESCAPE",
    "line": "Nothing about the arrangement is survivable for long.\nThe sunrise there happens once every day and a half.\nBecause it never turns its back on the star.",
    "start": 19.201,
    "end": 27.091,
    "dur": 7.89,
    "words": 27,
    "wav": "_v2beats/004.wav"
   },
   {
    "n": 5,
    "id": "the_star",
    "beat": "THE STAR",
    "line": "The star it rides is a blue furnace, spinning fast.\nUp there it is hotter than the planet it made.",
    "start": 27.171,
    "end": 33.037,
    "dur": 5.867,
    "words": 20,
    "wav": "_v2beats/005.wav"
   },
   {
    "n": 6,
    "id": "the_light",
    "beat": "THE LIGHT",
    "line": "The planet is cooking in a light most stars never give.",
    "start": 33.117,
    "end": 36.472,
    "dur": 3.355,
    "words": 11,
    "wav": "_v2beats/006.wav"
   },
   {
    "n": 7,
    "id": "the_dayside",
    "beat": "THE DAYSIDE",
    "line": "Its dayside reaches about forty-six hundred degrees.\nThat is not a temperature. That is a warning.",
    "start": 36.552,
    "end": 43.52,
    "dur": 6.968,
    "words": 16,
    "wav": "_v2beats/007.wav"
   },
   {
    "n": 8,
    "id": "molecules",
    "beat": "DISSOCIATION",
    "line": "Hydrogen molecules get torn apart before they can settle.\nIts atmosphere is pulled apart and dragged off into space.\nIt leaves a glowing tail, forever losing weight.",
    "start": 43.6,
    "end": 54.166,
    "dur": 10.566,
    "words": 27,
    "wav": "_v2beats/008.wav"
   },
   {
    "n": 9,
    "id": "the_warning",
    "beat": "THE WARNING",
    "line": "Here is the part that should stop you.\nOn the dayside, atoms begin to come undone.",
    "start": 54.246,
    "end": 59.806,
    "dur": 5.559,
    "words": 16,
    "wav": "_v2beats/009.wav"
   },
   {
    "n": 10,
    "id": "unraveling",
    "beat": "UNRAVELING",
    "line": "The bonds that make matter simply lose.\nThis is a planet disassembling itself in plain view.\nThe night side is almost gentle by comparison.\nOne half of it survives. The other half does not.",
    "start": 59.886,
    "end": 72.692,
    "dur": 12.807,
    "words": 34,
    "wav": "_v2beats/010.wav"
   },
   {
    "n": 11,
    "id": "nowhere_cool",
    "beat": "NOWHERE COOL",
    "line": "And there is nowhere cooler to stand.\nNo ocean. No shade. No door.\nJust a point you would call a star from far off.",
    "start": 72.772,
    "end": 81.155,
    "dur": 8.383,
    "words": 24,
    "wav": "_v2beats/011.wav"
   },
   {
    "n": 12,
    "id": "closer",
    "beat": "CLOSER",
    "line": "You would call it a planet. You would be generous.\nSomewhere out there, right now, it is happening.",
    "start": 81.235,
    "end": 87.327,
    "dur": 6.092,
    "words": 18,
    "wav": "_v2beats/012.wav"
   }
  ],
  "render_s": 0.7
 },
 {
