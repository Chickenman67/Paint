   ],
   "raw_wpm": 245.5,
   "speech_wpm": 172.7,
   "squeeze_saved_s": 2.74
  },
  "boundary_basis": "exact -- per-beat renders atempo-stretched then concatenated",
  "beats": [
   {
    "n": 1,
    "id": "backwards_hook",
    "beat": "HOOK",
    "line": "This planet goes the wrong way around its star.",
    "start": 0.0,
    "end": 3.16,
    "dur": 3.16,
    "words": 9,
    "wav": "_v2beats/001.wav"
   },
   {
    "n": 2,
    "id": "everyone_else_turns",
    "beat": "SETUP",
    "line": "Almost every other world in the galaxy turns the same direction.\nThis one runs backwards.",
    "start": 3.24,
    "end": 9.167,
    "dur": 5.927,
    "words": 15,
    "wav": "_v2beats/002.wav"
   },
   {
    "n": 3,
    "id": "not_made_here",
    "beat": "TURN",
    "line": "It was never made here.\nIt was thrown, or captured, or flung into this orbit.",
    "start": 9.247,
    "end": 14.373,
    "dur": 5.125,
    "words": 15,
    "wav": "_v2beats/003.wav"
   },
   {
    "n": 4,
    "id": "wrong_way_explained",
    "beat": "WHY",
    "line": "There is no ordinary reason for a world to turn against its star.\nWhatever put it here left it there.",
    "start": 14.453,
    "end": 20.572,
    "dur": 6.119,
    "words": 20,
    "wav": "_v2beats/004.wav"
   },
   {
    "n": 5,
    "id": "almost_nothing_there",
    "beat": "REVEAL",
    "line": "Now look at how little of it is actually there.\nIt is one of the puffiest planets we have ever measured.",
    "start": 20.652,
    "end": 26.553,
    "dur": 5.902,
    "words": 21,
    "wav": "_v2beats/005.wav"
   },
   {
    "n": 6,
    "id": "cork_density",
    "beat": "LOW_DENSITY",
    "line": "So low in density that it floats like a cork.\nA world the size of Jupiter, made of almost nothing.",
    "start": 26.633,
    "end": 33.421,
    "dur": 6.787,
    "words": 20,
    "wav": "_v2beats/006.wav"
   },
   {
    "n": 7,
    "id": "should_have_collapsed",
    "beat": "TENSION",
    "line": "It should have collapsed into itself a long time ago.\nThe heat down inside holds it open. That is all.",
    "start": 33.501,
    "end": 40.491,
    "dur": 6.99,
    "words": 20,
    "wav": "_v2beats/007.wav"
   },
   {
    "n": 8,
    "id": "cloud_wall",
    "beat": "CLOUDS",
    "line": "Its clouds stack so high they look like a wall of weather.\nAnd the wind in them never stops.",
    "start": 40.571,
    "end": 46.817,
    "dur": 6.247,
    "words": 19,
    "wav": "_v2beats/008.wav"
   },
   {
    "n": 9,
    "id": "endless_wind",
    "beat": "WINDS",
    "line": "The whole atmosphere just runs, endlessly, around the day side.\nThose clouds move faster than anything that size should.",
    "start": 46.897,
    "end": 54.783,
    "dur": 7.886,
    "words": 19,
    "wav": "_v2beats/009.wav"
   },
   {
    "n": 10,
    "id": "dayside_1700",
    "beat": "HEAT",
    "line": "The side facing the star hits seventeen hundred degrees.",
    "start": 54.863,
    "end": 58.652,
    "dur": 3.789,
    "words": 9,
    "wav": "_v2beats/010.wav"
   },
   {
    "n": 11,
    "id": "you_would_not",
    "beat": "FATE",
    "line": "You would not land here.\nYou would not orbit here.\nYou would not want to fall asleep here.",
    "start": 58.732,
    "end": 64.076,
    "dur": 5.344,
    "words": 18,
    "wav": "_v2beats/011.wav"
   },
   {
    "n": 12,
    "id": "three_wrongs",
    "beat": "RECAP",
    "line": "Backwards spin. Almost no weight. Endless wind.\nA planet that lost its place and never noticed.\nEvery part of it is wrong.",
    "start": 64.156,
    "end": 73.196,
    "dur": 9.04,
    "words": 22,
    "wav": "_v2beats/012.wav"
   },
   {
    "n": 13,
    "id": "never_supposed_to_be_here",
    "beat": "CLOSER",
    "line": "You are looking at a world nobody planned.\nIt is still there. It is still turning.\nIt was never supposed to be here.",
    "start": 73.276,
    "end": 80.887,
    "dur": 7.61,
    "words": 23,
    "wav": "_v2beats/013.wav"
   }
  ],
  "render_s": 0.8
 },
 {
  "segment": "wasp127b",
  "wav_path": "v2_audio.wav",
