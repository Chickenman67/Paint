   "end": 31.749,
   "dur": 2.524,
   "words": 7,
   "wav": "_beats/013.wav"
  },
  {
   "n": 14,
   "id": "b14",
   "beat": "COMPARISON",
   "line": "A camera flash would harm the paper.",
