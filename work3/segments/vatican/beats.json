   "end": 29.145,
   "dur": 2.276,
   "words": 6,
   "wav": "_beats/012.wav"
  },
  {
   "n": 13,
   "id": "b13",
   "beat": "ESCALATE",
   "line": "Not even a phone screen is allowed.",
