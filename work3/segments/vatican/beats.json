   "end": 17.527,
   "dur": 2.084,
   "words": 7,
   "wav": "_beats/007.wav"
  },
  {
   "n": 8,
   "id": "b08",
   "beat": "IMAGE",
   "line": "The shelves stretch out for kilometres.",
