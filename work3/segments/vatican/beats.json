   "end": 12.666,
   "dur": 2.519,
   "words": 6,
   "wav": "_beats/005.wav"
  },
  {
   "n": 6,
   "id": "b06",
   "beat": "PIVOT",
   "line": "Then the doors closed again, quietly.",
   "start": 12.746,
   "end": 15.363,
   "dur": 2.617,
   "words": 6,
   "wav": "_beats/006.wav"
  },
  {
   "n": 7,
   "id": "b07",
   "beat": "ESTABLISH",
   "line": "The rooms run deep under the hill.",
