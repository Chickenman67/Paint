   "end": 19.78,
   "dur": 2.173,
   "words": 6,
   "wav": "_beats/008.wav"
  },
  {
   "n": 9,
   "id": "b09",
   "beat": "IMAGE",
   "line": "A wooden ladder slides along a rail.",
