   "end": 21.796,
   "dur": 1.936,
   "words": 7,
   "wav": "_beats/009.wav"
  },
  {
   "n": 10,
   "id": "b10",
   "beat": "FACT",
   "line": "No electric light is allowed down there.",
   "start": 21.876,
   "end": 24.41,
   "dur": 2.534,
   "words": 7,
   "wav": "_beats/010.wav"
  },
  {
   "n": 11,
   "id": "b11",
   "beat": "ESTABLISH",
   "line": "Every window was walled up on purpose.",
   "start": 24.49,
   "end": 26.789,
   "dur": 2.299,
   "words": 7,
   "wav": "_beats/011.wav"
  },
  {
   "n": 12,
   "id": "b12",
   "beat": "PIVOT",
   "line": "Nobody may photograph a single page.",
