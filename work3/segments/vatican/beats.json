 "beats": [
  {
   "n": 1,
   "id": "b01",
   "beat": "HOOK",
   "line": "Beneath Vatican City there is an archive.",
   "start": 0.0,
   "end": 2.358,
   "dur": 2.358,
   "words": 7,
   "wav": "_beats/001.wav"
  },
  {
   "n": 2,
   "id": "b02",
   "beat": "HOOK",
   "line": "The rooms down there have no windows.",
   "start": 2.438,
   "end": 4.478,
   "dur": 2.04,
   "words": 7,
   "wav": "_beats/002.wav"
  },
  {
   "n": 3,
   "id": "b03",
   "beat": "TITLE",
   "line": "The place is called the Vatican Archives.",
   "start": 4.558,
   "end": 7.116,
   "dur": 2.558,
   "words": 7,
   "wav": "_beats/003.wav"
  },
  {
   "n": 4,
   "id": "b04",
   "beat": "FACT",
   "line": "The archive doors opened in 1939.",
   "start": 7.196,
   "end": 10.067,
   "dur": 2.871,
   "words": 6,
   "wav": "_beats/004.wav"
  },
  {
   "n": 5,
   "id": "b05",
   "beat": "FACT",
   "line": "They opened once, for outside scholars.",
