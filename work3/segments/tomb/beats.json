   "end": 18.027,
   "dur": 2.285,
   "words": 6,
   "wav": "_beats/007.wav"
  },
  {
   "n": 8,
   "id": "b08",
   "beat": "FACT",
   "line": "They stand in long rows, in earthen pits.",
