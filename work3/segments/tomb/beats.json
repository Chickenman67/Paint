   "end": 32.436,
   "dur": 3.658,
   "words": 8,
   "wav": "_beats/012.wav"
  },
  {
   "n": 13,
   "id": "b13",
   "beat": "FACT",
   "line": "China had been a hundred separate kingdoms.",
