   "end": 28.697,
   "dur": 2.439,
   "words": 8,
   "wav": "_beats/011.wav"
  },
  {
   "n": 12,
   "id": "b12",
   "beat": "FACT",
   "line": "In 221 BC he ended centuries of war.",
