 "beats": [
  {
   "n": 1,
   "id": "b01",
   "beat": "HOOK",
   "line": "Beneath this field, eight thousand soldiers stand waiting.",
   "start": 0.0,
   "end": 3.77,
   "dur": 3.77,
   "words": 8,
   "wav": "_beats/001.wav"
  },
  {
   "n": 2,
   "id": "b02",
   "beat": "HOOK",
   "line": "They are clay, and they are perfect.",
