 "beats": [
  {"n": 1, "id": "b01", "beat": "HOOK", "line": "This is the most secure building on Earth.", "start": 0.0, "end": 2.909, "dur": 2.909, "words": 8},
  {"n": 2, "id": "b02", "beat": "HOOK", "line": "Everyone in the country knows the name.", "start": 2.989, "end": 5.535, "dur": 2.546, "words": 7},
  {"n": 3, "id": "b03", "beat": "HOOK", "line": "Almost nobody has ever been inside.", "start": 5.615, "end": 7.796, "dur": 2.181, "words": 6},
  {"n": 4, "id": "b04", "beat": "IMAGE", "line": "It holds the gold of other nations.", "start": 7.876, "end": 10.422, "dur": 2.546, "words": 7},
  {"n": 5, "id": "b05", "beat": "PIVOT", "line": "Not only the gold of America.", "start": 10.502, "end": 12.684, "dur": 2.182, "words": 6},
  {"n": 6, "id": "b06", "beat": "ESTABLISH", "line": "It sits in the hills of Kentucky.", "start": 12.764, "end": 15.309, "dur": 2.545, "words": 7},
  {"n": 7, "id": "b07", "beat": "IMAGE", "line": "A long low building made of brick.", "start": 15.389, "end": 17.935, "dur": 2.546, "words": 7},
  {"n": 8, "id": "b08", "beat": "FACT", "line": "From the road it looks like a school.", "start": 18.015, "end": 20.924, "dur": 2.909, "words": 8},
  {"n": 9, "id": "b09", "beat": "REVEAL", "line": "It is not a school at all.", "start": 21.004, "end": 23.549, "dur": 2.545, "words": 7},
  {"n": 10, "id": "b10", "beat": "TITLE", "line": "This is Fort Knox, Kentucky.", "start": 23.629, "end": 25.447, "dur": 1.818, "words": 5},
  {"n": 11, "id": "b11", "beat": "FACT", "line": "Work began there in 1939.", "start": 25.527, "end": 27.345, "dur": 1.818, "words": 5},
  {"n": 12, "id": "b12", "beat": "FACT", "line": "The building was finished in 1944.", "start": 27.425, "end": 29.607, "dur": 2.182, "words": 6},
  {"n": 13, "id": "b13", "beat": "IMAGE", "line": "Five years of poured concrete and stone.", "start": 29.687, "end": 32.233, "dur": 2.546, "words": 7},
  {"n": 14, "id": "b14", "beat": "FACT", "line": "The roof was modelled on Gothic halls.", "start": 32.313, "end": 34.858, "dur": 2.545, "words": 7},
  {"n": 15, "id": "b15", "beat": "IMAGE", "line": "Vaulted stone arches above the corridors.", "start": 34.938, "end": 37.12, "dur": 2.182, "words": 6},
  {"n": 16, "id": "b16", "beat": "COMPARISON", "line": "Europe, rebuilt in the middle of Kentucky.", "start": 37.2, "end": 39.745, "dur": 2.545, "words": 7},
  {"n": 17, "id": "b17", "beat": "PIVOT", "line": "The doors mattered more than the roof.", "start": 39.825, "end": 42.371, "dur": 2.546, "words": 7},
  {"n": 18, "id": "b18", "beat": "ESCALATE", "line": "The main door weighs about 56 tons.", "start": 42.451, "end": 44.996, "dur": 2.545, "words": 7},
  {"n": 19, "id": "b19", "beat": "ESCALATE", "line": "It is reportedly the heaviest vault door made.", "start": 45.076, "end": 47.985, "dur": 2.909, "words": 8},
  {"n": 20, "id": "b20", "beat": "ESCALATE", "line": "A round steel face, cropped by the frame.", "start": 48.065, "end": 50.975, "dur": 2.91, "words": 8},
  {"n": 21, "id": "b21", "beat": "IMAGE", "line": "It swings on a solid steel hinge.", "start": 51.055, "end": 53.6, "dur": 2.545, "words": 7},
  {"n": 22, "id": "b22", "beat": "FACT", "line": "Steel plate, then concrete, then more steel.", "start": 53.68, "end": 56.225, "dur": 2.545, "words": 7},
  {"n": 23, "id": "b23", "beat": "ESCALATE", "line": "The concrete runs right through the walls.", "start": 56.305, "end": 58.851, "dur": 2.546, "words": 7},
  {"n": 24, "id": "b24", "beat": "REVEAL", "line": "The walls are thicker than the doors.", "start": 58.931, "end": 61.476, "dur": 2.545, "words": 7},
  {"n": 25, "id": "b25", "beat": "COMPARISON", "line": "A castle built to outlast a siege.", "start": 61.556, "end": 64.102, "dur": 2.546, "words": 7},
  {"n": 26, "id": "b26", "beat": "PIVOT", "line": "The gold sits on nine floors.", "start": 64.182, "end": 66.364, "dur": 2.182, "words": 6},
  {"n": 27, "id": "b27", "beat": "ESCALATE", "line": "Rows of bars stacked to the ceiling.", "start": 66.444, "end": 68.989, "dur": 2.545, "words": 7},
  {"n": 28, "id": "b28", "beat": "FACT", "line": "The reserve ran into the hundreds of billions.", "start": 69.069, "end": 71.978, "dur": 2.909, "words": 8},
  {"n": 29, "id": "b29", "beat": "FACT", "line": "At its peak it weighed 12,000 tonnes.", "start": 72.058, "end": 74.604, "dur": 2.546, "words": 7},
  {"n": 30, "id": "b30", "beat": "ESCALATE", "line": "The stacks filled whole wings of it.", "start": 74.684, "end": 77.229, "dur": 2.545, "words": 7},
  {"n": 31, "id": "b31", "beat": "FACT", "line": "Much of that gold belongs to other governments.", "start": 77.309, "end": 80.218, "dur": 2.909, "words": 8},
  {"n": 32, "id": "b32", "beat": "IMAGE", "line": "Small national flags above one vault door.", "start": 80.298, "end": 82.844, "dur": 2.546, "words": 7},
  {"n": 33, "id": "b33", "beat": "PIVOT", "line": "The vault holds their gold as well.", "start": 82.924, "end": 85.469, "dur": 2.545, "words": 7},
  {"n": 34, "id": "b34", "beat": "FACT", "line": "Only a small share stays on site.", "start": 85.549, "end": 88.095, "dur": 2.546, "words": 7},
  {"n": 35, "id": "b35", "beat": "ESCALATE", "line": "Only a few hundred tonnes remain.", "start": 88.175, "end": 90.356, "dur": 2.181, "words": 6},
  {"n": 36, "id": "b36", "beat": "FACT", "line": "The rest was moved out years ago.", "start": 90.436, "end": 92.982, "dur": 2.546, "words": 7},
  {"n": 37, "id": "b37", "beat": "IMAGE", "line": "A visitor counter, a ledger, a stamp.", "start": 93.062, "end": 95.607, "dur": 2.545, "words": 7},
  {"n": 38, "id": "b38", "beat": "FACT", "line": "Thousands of people tour it every year.", "start": 95.687, "end": 98.233, "dur": 2.546, "words": 7},
  {"n": 39, "id": "b39", "beat": "FACT", "line": "School field trips arrive each spring.", "start": 98.313, "end": 100.495, "dur": 2.182, "words": 6},
  {"n": 40, "id": "b40", "beat": "IMAGE", "line": "A line of children in a corridor.", "start": 100.575, "end": 103.12, "dur": 2.545, "words": 7},
  {"n": 41, "id": "b41", "beat": "COMPARISON", "line": "They walk above the stored gold.", "start": 103.2, "end": 105.382, "dur": 2.182, "words": 6},
  {"n": 42, "id": "b42", "beat": "PIVOT", "line": "They never walk below the gold.", "start": 105.462, "end": 107.644, "dur": 2.182, "words": 6},
  {"n": 43, "id": "b43", "beat": "ESCALATE", "line": "The inner doors stay bolted shut.", "start": 107.724, "end": 109.905, "dur": 2.181, "words": 6},
  {"n": 44, "id": "b44", "beat": "FINALE", "line": "Almost nobody alive has seen inside.", "start": 109.985, "end": 112.167, "dur": 2.182, "words": 6}
 ]
